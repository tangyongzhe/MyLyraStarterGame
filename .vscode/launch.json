    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "attach",
            "name": "TypeScript-Debug",
            "address": "localhost",
            "port": 8080,
            "localRoot": "${workspaceFolder}/TypeScript",
            "sourceMaps": true,
            "cwd": "${workspaceFolder}",
            "skipFiles": [
                "${workspaceFolder}/Content/JavaScript/puerts/log.js",
            ],
        },
        {
            "type": "node",
            "request": "attach",
            "name": "JavaScript-Debug",
            "address": "localhost",
            "port": 8080,
            "localRoot": "${workspaceFolder}/Content/JavaScript",
            "sourceMaps": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "node",
            "request": "attach",
            "name": "DS_TypeScript-Debug",
            "address": "localhost",
            "port": 18989,
            "localRoot": "${workspaceFolder}/TypeScript",
            "sourceMaps": true,
            "cwd": "${workspaceFolder}",
            "skipFiles": [
                "${workspaceFolder}/Content/JavaScript/puerts/log.js",
            ],
        },
    ]
}